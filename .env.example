# ==============================================================================
# AIEL DESIGN & PRINTING STUDIO — ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development or set in Hostinger / Vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Row-Level Security)
# Client-side safe: VITE_ prefix exposes these to browser bundle.
# ONLY use the publishable / anon key here (sb_publishable_... or anon key).
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://cisbahsmzwqqrmmwgncp.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-here

# Server-only (DO NOT prefix with VITE_). Keep secure!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway
# ------------------------------------------------------------------------------
# Fallback payment link (if standard checkout is not used)
VITE_RAZORPAY_PAYMENT_LINK=https://razorpay.me/@stella3321

# Razorpay Standard Checkout Key ID (Client-safe)
# e.g. rzp_live_xxxxxxxxxxxx or rzp_test_xxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id-here

# Razorpay Key Secret & Webhook Secret (Server-only, DO NOT expose to client)
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here

# ------------------------------------------------------------------------------
# 3. Resend Email Service & URLs
# Server-only. Used for order confirmation & customer notifications.
# ------------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Aiel Studio <orders@aieldesignstudio.com>
SITE_URL=https://aieldesignstudio.com
SUPPORT_EMAIL=orders@aieldesignstudio.com

# ------------------------------------------------------------------------------
# 4. WhatsApp Business Order Integration
# ------------------------------------------------------------------------------
VITE_WHATSAPP_PHONE=919150234277
